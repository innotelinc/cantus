#!/usr/bin/perl
# Cantus 1.0 reference implementation — command line.
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Getopt::Long qw(GetOptions);

use Cantus::Wire ();
use Cantus::Caps ();
use Cantus::Media ();
use Cantus::Reach ();
use Cantus::Router ();
use Cantus::Session ();
use Cantus::Scenario ();
use Cantus::Daemon ();
use Cantus::Health ();
use Cantus::Gateway ();
use Cantus::Phone ();
use JSON::PP ();
use IO::Socket::INET ();

my $VERSION = '1.0.0';

my $cmd = shift @ARGV // 'help';

if ($cmd eq 'version' || $cmd eq '--version') {
    print "cantus $VERSION (wire token cantus/1, port 7443/udp, TCP fallback on 7443)\n";
    exit 0;
}
if ($cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h') {
    print <<"USAGE";
cantus $VERSION — a realtime voice standard built around one socket

  cantus demo [--nat none|cone|symmetric] [--rebind] [--quiet] [--media SECONDS] [--json]
      Run a relay and two endpoints, place a real call over real sockets,
      and report the path that was chosen and the audio that arrived.
      --rebind flushes the NAT tables mid-call and shows the failover to the
      relay and the return to a direct path.

  cantus gateway --config gateway.json [--quiet]
      The SIP edge: one account per line, G.711 at the border and pcm-s16
      inside, with the call control a phone expects -- DTMF, hold and REFER
      transfer -- and a CDR line for every call. A registered softphone calls
      it; the call is placed through a Cantus node, so reach, relay fallback
      and rebinding are the same code a production node runs.

  cantus phone --server HOST:PORT --password PW [--user 101] [--target 102]
               [--answer] [--actions "dtmf:5,hold:1,resume:1,refer:102"]
               [--seconds 6] [--json]
      A SIP test phone: register with digest auth, then either invite
      --target or, with --answer, wait for a call and pick it up. It sends a
      tone at the asked-for amplitude and reports what came back -- frames,
      peak, whether the far end's 440 Hz tone arrived, and the digits it
      heard.

  cantus health [--config node.json] [--nat symmetric] [--json]
      What a container runs as its health check: place a real call behind a
      symmetric NAT, flush the mapping mid-call, and fail unless the relay
      carried it and the call survived. With --config it also proves the
      daemon still holds its socket, which a scenario run alone cannot.

  cantus route-test <document.json> [--to AOR] [--from AOR] [--hour HH:MM]
      Evaluate a routing document offline.  Nothing is executed.

  cantus node --config node.json [--events|--quiet] [--stats SECONDS]
      Run a node and stay up: one UDP socket, keepalives, Reach, and the
      registration that keeps the relay pointed at this address.  The config
      carries id, bind, relay and optional routes; CANTUS_SECRET overrides the
      secret so the file can be committed.

  cantus relay --config relay.json [--events|--quiet] [--stats SECONDS]
      Run a relay and stay up: registrations, observed addresses, expiry, and
      name- or handle-addressed forwarding.  It holds no call state.

  cantus encode hello|invite|media
      Print the wire encoding of a sample message.

  cantus selftest
      In-process checks of framing, negotiation and routing.

USAGE
    exit 0;
}

if ($cmd eq 'node' || $cmd eq 'relay') {
    my ($config, $events, $quiet, $stats) = (undef, undef, 0, undef);
    GetOptions('config=s' => \$config, 'events=s' => \$events, 'quiet' => \$quiet,
               'stats=f' => \$stats)
        or die "cantus: bad options for $cmd (try: cantus help)\n";
    my $daemon = Cantus::Daemon->new(
        role   => $cmd,
        config => Cantus::Daemon::load_config($config),
        events => $events,
        quiet  => $quiet,
        stats  => $stats,
    );
    exit $daemon->run;
}

if ($cmd eq 'demo') {
    my ($nat, $quiet, $media, $verbose, $rebind, $json) = ('none', 0, 1.2, 0, 0, 0);
    GetOptions('nat=s' => \$nat, 'quiet' => \$quiet, 'media=f' => \$media,
               'verbose' => \$verbose, 'rebind' => \$rebind, 'json' => \$json);
    die "cantus: --rebind needs a middlebox (--nat cone or symmetric)\n"
        if $rebind && $nat eq 'none';
    die "cantus: --nat must be none, cone or symmetric\n"
        unless $nat =~ /^(none|cone|symmetric)$/;

    printf "cantus $VERSION — demo, nat=%s\n\n", $nat;
    my $scenario = Cantus::Scenario->new(
        nat   => $nat,
        trace => sub {
            my ($who, $ev) = @_;
            return if $quiet;
            return if !$verbose && ($ev->{kind} // '') eq 'forward';
            printf "  %7.3fs  %-11s %s\n", $ev->{t} // 0, $who, _describe($ev, $who);
        },
    );
    my $r = $scenario->run(
        media_seconds => $rebind ? ($media > 9 ? $media : 9) : $media,
        ($rebind ? (rebind_at => 0.5) : ()),
    );

    my $verdict = Cantus::Health::verdict($r, nat => $nat, rebind => $rebind);

    if ($json) {
        print JSON::PP->new->canonical->encode({
            ok            => $verdict->{ok} ? JSON::PP::true : JSON::PP::false,
            error         => $verdict->{error},
            nat           => $nat,
            rebind        => $rebind ? 1 : 0,
            call          => $r->{call},
            codec         => $r->{codec},
            path          => $r->{path},
            frames        => $r->{frames} // 0,
            peak          => $r->{peak} // 0,
            direct_frames => $r->{direct_frames} // 0,
            relay_frames  => $r->{relay_frames} // 0,
            ended         => $r->{ended} ? 1 : 0,
            recovered_at  => $r->{recovered_at},
            premature_end => $r->{premature_end} // 0,
        }), "\n";
        exit($verdict->{ok} ? 0 : 1);
    }

    print "\n";
    if (!$r->{ok}) {
        printf "FAILED: %s\n", $r->{error} // 'media did not arrive';
        exit 1;
    }
    printf "  call          %s\n", $r->{call};
    printf "  codec         %s\n", $r->{codec} // '?';
    my $note = $r->{path} eq 'relay' ? '  (direct was not usable, relay carried it)'
             : $r->{fell_back}      ? '  (relay carried the outage, then direct recovered)'
             :                        '  (no relay needed)';
    printf "  path          %s%s\n", $r->{path}, $note;
    printf "  audio         %d frames received, peak amplitude %d\n", $r->{frames}, $r->{peak};
    printf "  direct/relay  %d / %d frames\n", $r->{direct_frames}, $r->{relay_frames};
    printf "  ended         %s\n", $r->{ended} ? 'clean' : 'unclean';
    if ($rebind) {
        printf "  rebinding     nat table flushed; fallback=%s, direct restored %s\n",
            $r->{fell_back} ? 'yes' : 'no',
            defined $r->{recovered_at} ? sprintf('at %.2fs', $r->{recovered_at}) : 'never';
        printf "  continuity    %d frames on the relay, %d after recovery, call dropped: %s\n",
            $r->{relay_frames}, $r->{frames} - ($r->{frames_at_recovery} // 0),
            $r->{premature_end} ? 'yes' : 'no';
    }
    if (my $st = $r->{relay_stats}) {
        printf "  relay         %d forwarded, %d dropped, %d endpoints\n",
            @$st{qw(forwarded dropped endpoints)};
    }
    if (my %ns = %{ $r->{nat_stats} || {} }) {
        printf "  nat           %s: %d dropped unsolicited, %d forwarded\n",
            $_, $ns{$_}{dropped}, $ns{$_}{forwarded} for sort keys %ns;
    }
    if (!$verdict->{ok}) {
        printf "\nFAILED: %s\n", $verdict->{error};
        exit 1;
    }
    print "\nPASS\n";
    exit 0;
}

if ($cmd eq 'gateway') {
    my ($config, $quiet) = (undef, 0);
    GetOptions('config=s' => \$config, 'quiet' => \$quiet)
        or die "cantus: bad options for gateway (try: cantus help)\n";
    die "cantus: gateway needs --config <file>\n" unless defined $config;
    my $gateway = Cantus::Gateway->new(
        config => Cantus::Daemon::load_config($config),
        quiet  => $quiet,
    );
    exit $gateway->run;
}

if ($cmd eq 'phone') {
    my ($server, $user, $password, $target, $seconds, $json, $answer, $actions) =
        ('127.0.0.1:5062', '101', undef, undef, 6, 0, 0, undef);
    GetOptions('server=s' => \$server, 'user=s' => \$user, 'password=s' => \$password,
               'target=s' => \$target, 'seconds=f' => \$seconds, 'json' => \$json,
               'answer' => \$answer, 'actions=s' => \$actions)
        or die "cantus: bad options for phone (try: cantus help)\n";
    $password //= $ENV{GATEWAY_PASSWORD};
    die "cantus: phone needs --password or GATEWAY_PASSWORD\n" unless defined $password;

    my $phone = Cantus::Phone->new(
        server => $server, user => $user, password => $password,
        target => $target // $user, seconds => $seconds, quiet => $json,
    );
    my ($ok, $why) = $phone->register;
    if ($ok) {
        if ($answer) {
            my $invite = $phone->wait_invite($seconds);
            ($ok, $why) = $invite ? $phone->answer($invite) : (0, 'no call arrived');
        }
        else {
            ($ok, $why) = $phone->invite;
            ($ok, $why) = $phone->wait_answered if $ok;
        }
    }

    my $report = { ok => 0, error => $why };
    if ($ok) {
        my %tot = (rx_frames => 0, tx_frames => 0, rx_peak => 0, dtmf => '');
        my $add = sub {
            my ($w) = @_;
            $tot{rx_frames} += $w->{rx_frames};
            $tot{tx_frames} = $w->{tx_frames};
            $tot{rx_peak} = $w->{rx_peak} if $w->{rx_peak} > $tot{rx_peak};
            $tot{tone_440}  = $w->{tone_440};
            $tot{heard_tone} = 1 if $w->{heard_tone};
            $tot{dtmf} .= join('', @{ $w->{dtmf} || [] });
            $tot{ended} = 1 if $w->{ended};
        };
        for my $a (split /,/, ($actions // '')) {
            next unless length $a;
            if    ($a =~ /^dtmf:(.+)$/)            { $phone->send_dtmf($1); $add->($phone->pump(0.3)) }
            elsif ($a =~ /^hold(?::([\d.]+))?$/)   { $phone->hold;   $add->($phone->pump($1 // 1)) }
            elsif ($a =~ /^resume(?::([\d.]+))?$/) { $phone->resume; $add->($phone->pump($1 // 1)) }
            elsif ($a =~ /^refer:(.+)$/)           { $phone->refer($1); $add->($phone->pump(1.5)) }
            elsif ($a =~ /^wait:([\d.]+)$/)        { $add->($phone->pump($1)) }
            else { die "cantus: unknown action '$a' (dtmf:D, hold[:S], resume[:S], refer:EXT, wait:S)\n" }
        }
        $add->($phone->pump($seconds));
        $phone->bye unless $tot{ended};
        $report = { ok => 1, answered => $phone->{answered} ? 1 : 0, %tot };
    }

    if ($json) {
        print JSON::PP->new->canonical->encode($report), "\n";
    }
    else {
        print join(' ', map { "$_=" . (defined $report->{$_} ? $report->{$_} : '-') }
                        sort keys %$report), "\n";
    }
    exit($report->{ok} ? 0 : 1);
}

if ($cmd eq 'health') {
    my ($config, $nat, $json) = (undef, 'symmetric', 0);
    GetOptions('config=s' => \$config, 'nat=s' => \$nat, 'json' => \$json)
        or die "cantus: bad options for health (try: cantus help)\n";
    die "cantus: --nat must be none, cone or symmetric\n"
        unless $nat =~ /^(none|cone|symmetric)$/;

    my $report = sub {
        my ($ok, $error, $r) = @_;
        if ($json) {
            print JSON::PP->new->canonical->encode({
                ok            => $ok ? JSON::PP::true : JSON::PP::false,
                error         => $error,
                nat           => $nat,
                path          => $r ? $r->{path} : undef,
                frames        => $r ? ($r->{frames} // 0) : 0,
                peak          => $r ? ($r->{peak} // 0) : 0,
                relay_frames  => $r ? ($r->{relay_frames} // 0) : 0,
                premature_end => $r ? ($r->{premature_end} // 0) : 0,
            }), "\n";
        } else {
            printf "cantus health: %s%s\n", $ok ? 'ok' : 'unhealthy', $error ? " — $error" : '';
        }
        exit($ok ? 0 : 1);
    };

    # A scenario run in this process proves the library, not that the service is
    # up. With a config in hand the socket has to be taken already: if this
    # process can bind the configured port, nothing is listening on it.
    if (defined $config) {
        my $cfg = Cantus::Daemon::load_config($config);
        my ($host, $port) = split /:/, ($cfg->{bind} // ''), 2;
        $host = '0.0.0.0' unless defined $host && length $host;
        if (my $sock = IO::Socket::INET->new(
                LocalAddr => $host, LocalPort => $port, Proto => 'udp', ReuseAddr => 0)) {
            close $sock;
            $report->(0, "nothing is listening on $host:$port", undef);
        }
    }

    my $scenario = Cantus::Scenario->new(nat => $nat);
    my $r = $scenario->run(media_seconds => 9, rebind_at => 0.5);
    my $v = Cantus::Health::verdict($r, nat => $nat, rebind => 1);
    $report->($v->{ok}, $v->{error}, $r);
}

if ($cmd eq 'route-test') {
    my $file = shift @ARGV or die "usage: cantus route-test <document.json>\n";
    my ($to, $from, $hour) = ('support\@example.net', 'alice\@example.net', undef);
    GetOptions('to=s' => \$to, 'from=s' => \$from, 'hour=s' => \$hour);
    my $router = Cantus::Router->new;
    open my $fh, '<', $file or die "cantus: $file: $!\n";
    my $doc = do { local $/; <$fh> };
    close $fh;
    $router->load($doc);
    my $now = time;
    if (defined $hour) {
        my ($h, $m) = split /:/, $hour;
        my @t = localtime($now);
        $now = $now - ($t[2] * 3600 + $t[3] * 60 + $t[4]) + $h * 3600 + ($m // 0) * 60;
    }
    my $d = $router->decide({ to => $to, from => $from, now => $now, verified => 1, calls => 0 });
    printf "route   %s\n", $d->{route} // '(default)';
    my @chain = map { my ($k) = keys %$_; $k } @{ $d->{actions} };
    printf "actions %s\n", join(' -> ', @chain);
    exit 0;
}

if ($cmd eq 'encode') {
    my $what = shift @ARGV // 'hello';
    if ($what eq 'hello') {
        my $f = {
            21 => Cantus::Wire::S('cantus/1'),
            1  => Cantus::Wire::S('alice@demo'),
            24 => Cantus::Wire::B("\x01" x 32),
            9  => Cantus::Wire::B(Cantus::Caps::encode(Cantus::Caps::loopback_set())),
            4  => Cantus::Wire::V(1),
        };
        _hexdump('HELLO', Cantus::Wire::msg_encode(1, $f));
    }
    elsif ($what eq 'invite') {
        my $f = {
            1  => Cantus::Wire::S('alice@demo'),
            2  => Cantus::Wire::S('bob@demo'),
            3  => Cantus::Wire::S('0123456789abcdef0123456789abcdef'),
            6  => Cantus::Wire::V(1),
            9  => Cantus::Wire::B(Cantus::Caps::encode(Cantus::Caps::loopback_set())),
            12 => Cantus::Wire::B(Cantus::Reach::cands_encode(
                    { kind => 0, ip => '203.0.113.7', port => 7443, priority => 100,
                      token => 'ABCDEFGH' })),
            4  => Cantus::Wire::V(1),
        };
        _hexdump('INVITE', Cantus::Wire::msg_encode(3, $f));
    }
    else {
        my ($payload) = Cantus::Media::pcm_frame(samples => 960);
        _hexdump('MEDIA', Cantus::Wire::media_encode(
            stream => 0, tag => 0x1234, seq => 1000, ts => 48000,
            codec => 1, flags => 4, payload => substr($payload, 0, 40),
        ));
    }
    exit 0;
}

if ($cmd eq 'selftest') {
    my @checks;
    my $ok = sub { my ($name, $pass) = @_; push @checks, [ $name, $pass ? 1 : 0 ] };

    my $v = Cantus::Wire::varint_encode(2**40 + 17);
    my $pos = 0;
    $ok->('varint round-trip', Cantus::Wire::varint_decode($v, \$pos) == 2**40 + 17);

    my $m = Cantus::Wire::media_encode(stream=>0, tag=>7, seq=>1, ts=>960, codec=>2, flags=>0, payload=>'abc');
    $ok->('media round-trip', (Cantus::Wire::media_decode($m))->{payload} eq 'abc');

    my $agreed = Cantus::Caps::negotiate(
        [ { name => 'opus/48000/2', ptime => 20, params => {} },
          { name => 'pcm-s16/48000/1', ptime => 20, params => {} } ],
        [ { name => 'pcm-s16/48000/1', ptime => 20, params => {} },
          { name => 'opus/48000/2', ptime => 20, params => {} } ],
    );
    $ok->('caller codec precedence', ($agreed->{name} // '') eq 'opus/48000/2');

    my $r = Cantus::Router->new(doc => Cantus::Router::default_doc);
    $ok->('routing default', $r->decide({ to => 'x@y', from => 'a@b' })->{route} eq 'answer-all');

    my $s = Cantus::Session->new(call => 'c', role => 'caller', peer => 'p');
    $s->fire('invite_sent');
    $s->fire('accept_recv');
    $ok->('session reaches ACTIVE', $s->commit_path('relay') && $s->is_active);

    my $fail = grep { !$_->[1] } @checks;
    printf "%-28s %s\n", $_->[0], $_->[1] ? 'ok' : 'FAIL' for @checks;
    print $fail ? "\nFAIL ($fail)\n" : "\nPASS\n";
    exit($fail ? 1 : 0);
}

print "cantus: unknown command '$cmd' (try: cantus help)\n";
exit 2;

sub _describe {
    my ($ev, $who) = @_;
    my $k = $ev->{kind} // '?';
    return "incoming call=$ev->{call} from=$ev->{from}" if $k eq 'incoming';
    return "accepted call=$ev->{call} codec=$ev->{codec}" if $k eq 'accepted' && $ev->{codec};
    return "path $ev->{path} committed at $ev->{ms}ms" if $k eq 'path';
    return "ended call=$ev->{call} reason=$ev->{reason}" if $k eq 'ended';
    return "registered $ev->{id} at $ev->{addr} handle=$ev->{handle}" if $k eq 'registered' && $who eq 'relay';
    return "registered handle=$ev->{handle} observed=$ev->{observed}" if $k eq 'registered';
    return "nat $ev->{mode} at $ev->{at}" if $k eq 'nat';
    return "invite call=$ev->{call} to=$ev->{to}" if $k eq 'invite';
    return "rebinding to relay after $ev->{after_ms}ms of silence" if $k eq 'rebind';
    return "$k call=$ev->{call}" if $k eq 'ringing';
    return join(' ', $k, map { "$_=$ev->{$_}" } grep { !/^(t|kind|who)$/ } sort keys %$ev);
}

sub _hexdump {
    my ($label, $bytes) = @_;
    printf "%s — %d octets\n", $label, length $bytes;
    my $off = 0;
    while ($off < length $bytes) {
        my $chunk = substr($bytes, $off, 16);
        my $hex = join ' ', map { sprintf '%02X', ord } split //, $chunk;
        my $asc = join '', map { /[\x20-\x7e]/ ? $_ : '.' } split //, $chunk;
        printf "%04X  %-47s  %s\n", $off, $hex, $asc;
        $off += 16;
    }
}
